{
  "name": "pi-search",
  "description": "Provider-neutral web search and fetching tools for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "web-search",
    "web-fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nijaru/pi-search.git"
  },
  "bugs": {
    "url": "https://github.com/nijaru/pi-search/issues"
  },
  "homepage": "https://github.com/nijaru/pi-search#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/bun": "1.3.14",
    "@types/turndown": "^5.0.6",
    "typebox": "1.3.6",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.4"
  }
